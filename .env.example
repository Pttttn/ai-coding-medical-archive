# Optional. The default demo needs no .env file.
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
UI_PORT=8080
API_PORT=3000
MCP_PORT=8002
SEED_ENABLED=true
RAG_TRACE=false
# Use distinct values for personal archives. These are local service credentials,
# not cloud API keys; no cloud key is used by the application.
POSTGRES_PASSWORD=local-demo-password
INTERNAL_API_TOKEN=local-internal-demo-token

# Optional in-contour llama.cpp mode (compose.yaml + compose.host-ollama.yaml +
# compose.llama-mpc1.yaml). LLM chat goes to an OpenAI-compatible llama.cpp
# server; embeddings stay on the local host Ollama. The key file must live
# outside the repository and is mounted read-only into the shim container.
# LLM_MODEL=qwen3.8-27b-q8-100k-cuda
# EMBEDDING_MODEL=nomic-embed-text
# LLAMA_MPC1_URL=http://10.44.0.67:11435/v1/chat/completions
# LLAMA_MPC1_KEY_FILE=/Users/ruslan/.llama-mpc1.keys
