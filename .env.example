# Optional. The default demo needs no .env file.
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
UI_PORT=8080
API_PORT=3000
MCP_PORT=8002
SEED_ENABLED=true
RAG_TRACE=false
# Use distinct values for personal archives. These are local service credentials,
# not cloud API keys; no cloud key is used by the application.
POSTGRES_PASSWORD=local-demo-password
INTERNAL_API_TOKEN=local-internal-demo-token
